{
  "name": "mume-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Mume collaborative markdown editor",
  "type": "module",
  "scripts": {
    "pretest": "./scripts/start-test-servers.sh",
    "test": "playwright test",
    "posttest": "./scripts/stop-test-servers.sh",
    "test:ui": "./scripts/start-test-servers.sh && playwright test --ui; ./scripts/stop-test-servers.sh",
    "test:headed": "./scripts/start-test-servers.sh && playwright test --headed; ./scripts/stop-test-servers.sh",
    "test:debug": "./scripts/start-test-servers.sh && playwright test --debug; ./scripts/stop-test-servers.sh",
    "test:report": "playwright show-report",
    "test:manual": "playwright test",
    "start:servers": "./scripts/start-test-servers.sh",
    "stop:servers": "./scripts/stop-test-servers.sh",
    "setup:db": "tsx setup/seed-database.ts",
    "setup:services": "tsx setup/wait-for-services.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "redis": "^4.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
